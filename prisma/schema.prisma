datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(uuid())
  clerkUserId    String?       @unique
  username       String        @unique
  fullName       String
  displayName    String?
  passwordHash   String?       @default("")
  role           String        @default("USER") // "USER" or "ADMIN"
  membershipTier String        @default("FREE") // "FREE" or "VIP"
  isSuspended    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  profile       Profile?
  subscription  Subscription?
  payments      Payment[]
  notifications Notification[]

  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")

  chatSessionsA    ChatSession[] @relation("ChatSessionUserA")
  chatSessionsB    ChatSession[] @relation("ChatSessionUserB")

  blockedUsers Block[] @relation("Blocker")
  blockedBy    Block[] @relation("Blocked")

  bansAuthor   UserBan[] @relation("BanAuthor")
  bannedUsers  UserBan[] @relation("BannedSubject")

  sentReports  Report[] @relation("Reporter")
  reportedBy   Report[] @relation("Reported")
}

model Profile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                    String    @default("")
  showBio                Boolean   @default(true)
  age                    Int       @default(18)
  gender                 String    @default("unspecified") // "male", "female", "nonbinary", "prefer_not_to_say", "unspecified"
  showGender             Boolean   @default(true)
  preferredGender        String    @default("auto") // "auto", "male", "female", "any"
  personalityPreferences String    @default("") // Comma-separated personality tags (e.g. "Talkative,Funny,Friendly")
  mood                   String    @default("") // Current mood emoji + title
  showMood               Boolean   @default(true)
  moodExpiresAt          DateTime?
  language               String    @default("english") // "english", "hindi", "spanish", "french", "any"
  saveChatHistory        Boolean   @default(false)
  interests              String    @default("") // Comma-separated interests
  avatarType             String    @default("EMOJI") // "EMOJI" or "IMAGE"
  avatarEmoji            String    @default("😊") // Default avatar emoji
  avatarUrl              String?   // Custom image URL for VIP
  isOnline               Boolean   @default(false)
  lastSeen               DateTime  @default(now())
  themePreference        String    @default("system") // "light", "dark", "system"
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model MatchmakingQueue {
  id              String   @id @default(uuid())
  userId          String   @unique
  status          String   @default("WAITING") // WAITING, MATCHED, CANCELLED, EXPIRED
  chatSessionId   String?
  partnerUserId   String?
  gender          String   @default("unspecified")
  preferredGender String   @default("auto")
  language        String   @default("english")
  isVIP           Boolean  @default(false)
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, joinedAt])
}

model ChatSession {
  id             String    @id @default(uuid())
  userAId        String
  userBId        String
  status         String    @default("ACTIVE") // "ACTIVE", "ENDED"
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime?

  userA User @relation("ChatSessionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ChatSessionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  messages Message[]
}

model Message {
  id              String       @id @default(uuid())
  clientMessageId String?      @unique
  chatSessionId   String?
  senderId        String
  receiverId      String
  content         String
  imageUrl        String?
  isRead          Boolean      @default(false)
  isDeleted       Boolean      @default(false)
  createdAt       DateTime     @default(now())

  chatSession ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  sender      User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User        @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model UserBan {
  id             String   @id @default(uuid())
  bannedByUserId String
  bannedUserId   String
  createdAt      DateTime @default(now())

  bannedBy   User @relation("BanAuthor", fields: [bannedByUserId], references: [id], onDelete: Cascade)
  bannedUser User @relation("BannedSubject", fields: [bannedUserId], references: [id], onDelete: Cascade)

  @@unique([bannedByUserId, bannedUserId])
  @@index([bannedByUserId])
  @@index([bannedUserId])
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  status         String   @default("PENDING") // PENDING, RESOLVED
  createdAt      DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  amount            Int
  currency          String   @default("INR")
  plan              String   @default("VIP")
  status            String   @default("PENDING") // PENDING, CREATED, SUCCESS, FAILED, CANCELLED, REFUNDED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @unique
  plan               String    @default("VIP")
  isActive           Boolean   @default(false)
  subscriptionStatus String    @default("INACTIVE") // INACTIVE, ACTIVE, EXPIRED, CANCELLED
  subscriptionId     String?
  razorpayOrderId    String?
  razorpayPaymentId  String?
  startDate          DateTime  @default(now())
  endDate            DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("SYSTEM") // MESSAGE, SYSTEM, ADMIN, PAYMENT
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

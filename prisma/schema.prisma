datasource db {
  provider = "sqlite"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x", "windows"]
}

model User {
  id              String        @id @default(uuid())
  firebaseUid     String?       @unique
  clerkUserId     String?       @unique
  username        String        @unique
  fullName        String
  displayName     String?
  email           String?
  gender          String        @default("unspecified") // "male", "female", "non-binary", "prefer_not_to_say", "unspecified"
  dob             DateTime?
  genderDobLocked Boolean       @default(false) // Admin override lock
  passwordHash    String?       @default("")
  role            String        @default("USER") // "USER" or "ADMIN"
  membershipTier  String        @default("FREE") // "FREE" or "VIP"
  is_vip          Boolean       @default(false)
  vip_started_at  DateTime?
  vip_expires_at  DateTime?
  isSuspended     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile           Profile?
  subscription      Subscription?
  payments          Payment[]
  manualUpiPayments ManualUpiPayment[]
  vipRequests       VipRequest[]
  paymentRequests   PaymentRequest[]
  notifications     Notification[]
  adminLogs         AdminLog[]

  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")

  chatSessionsA    ChatSession[] @relation("ChatSessionUserA")
  chatSessionsB    ChatSession[] @relation("ChatSessionUserB")

  blockedUsers Block[] @relation("Blocker")
  blockedBy    Block[] @relation("Blocked")

  bansAuthor   UserBan[] @relation("BanAuthor")
  bannedUsers  UserBan[] @relation("BannedSubject")

  sentReports  Report[] @relation("Reporter")
  reportedBy   Report[] @relation("Reported")
}

model Profile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                    String    @default("")
  showBio                Boolean   @default(true)
  age                    Int       @default(18)
  gender                 String    @default("unspecified") // "male", "female", "non-binary", "prefer_not_to_say", "unspecified"
  dob                    DateTime?
  ageGenderConfirmed     Boolean   @default(false)
  ageGenderChangesCount  Int       @default(0)
  showGender             Boolean   @default(true)
  preferredGender        String    @default("auto") // "auto", "male", "female", "any"
  personalityPreferences String    @default("") // Comma-separated personality tags (e.g. "Talkative,Funny,Friendly")
  mood                   String    @default("") // Current mood emoji + title
  showMood               Boolean   @default(true)
  moodExpiresAt          DateTime?
  language               String    @default("english") // "english", "hindi", "spanish", "french", "any"
  saveChatHistory        Boolean   @default(false)
  interests              String    @default("") // Comma-separated interests
  avatarType             String    @default("EMOJI") // "EMOJI" or "IMAGE"
  avatarEmoji            String    @default("😊") // Default avatar emoji
  avatarUrl              String?   // Custom image URL for VIP
  isOnline               Boolean   @default(false)
  lastSeen               DateTime  @default(now())
  themePreference        String    @default("system") // "light", "dark", "system"
  randomChatIntroSeen    Boolean   @default(false)
  nameChangesCount       Int       @default(0)
  nameChangesDate        DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model MatchmakingQueue {
  id              String   @id @default(uuid())
  userId          String   @unique
  socketId        String?
  gender          String   @default("unspecified")
  preferredGender String   @default("auto")
  language        String   @default("english")
  status          String   @default("WAITING") // WAITING, MATCHED, CANCELLED
  chatSessionId   String?
  partnerUserId   String?
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, gender, preferredGender])
}

model ChatSession {
  id        String    @id @default(uuid())
  userAId   String
  userBId   String
  status    String    @default("ACTIVE") // ACTIVE, ENDED
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  userA User @relation("ChatSessionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ChatSessionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([userAId, status])
  @@index([userBId, status])
}

model Message {
  id              String   @id @default(uuid())
  clientMessageId String?
  chatSessionId   String
  senderId        String
  content         String
  imageUrl        String?
  status          String   @default("SENT") // SENDING, SENT, FAILED
  createdAt       DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  sender      User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User?       @relation("ReceivedMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, createdAt])
  @@index([clientMessageId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model UserBan {
  id             String   @id @default(uuid())
  bannedByUserId String
  bannedUserId   String
  createdAt      DateTime @default(now())

  bannedBy   User @relation("BanAuthor", fields: [bannedByUserId], references: [id], onDelete: Cascade)
  bannedUser User @relation("BannedSubject", fields: [bannedUserId], references: [id], onDelete: Cascade)

  @@unique([bannedByUserId, bannedUserId])
  @@index([bannedByUserId])
  @@index([bannedUserId])
}

model Report {
  id                String   @id @default(uuid())
  reporterId        String
  reportedUserId    String
  reason            String
  snapshotMessages  String?  // JSON stringified snapshot of conversation messages
  status            String   @default("PENDING") // PENDING, RESOLVED
  createdAt         DateTime @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  amount            Int
  currency          String   @default("INR")
  plan              String   @default("VIP")
  status            String   @default("PENDING") // PENDING, CREATED, SUCCESS, FAILED, CANCELLED, REFUNDED, CAPTURED
  qrImageUrl        String?
  qrCodeId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String    @id @default(uuid())
  userId             String    @unique
  plan               String    @default("VIP")
  isActive           Boolean   @default(false)
  subscriptionStatus String    @default("INACTIVE") // INACTIVE, ACTIVE, EXPIRED, CANCELLED
  subscriptionId     String?
  razorpayOrderId    String?
  razorpayPaymentId  String?
  startDate          DateTime  @default(now())
  endDate            DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("SYSTEM") // MESSAGE, SYSTEM, ADMIN, PAYMENT
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ManualUpiPayment {
  id               String    @id @default(uuid())
  paymentId        String    @unique @default(uuid())
  userId           String
  merchantName     String    @default("Lexino Enterprises")
  amount           Float     @default(99.0)
  planName         String    @default("VIP Membership")
  utrNumber        String?
  screenshotUrl    String?
  status           String    @default("UNDER_REVIEW") // PENDING_PAYMENT, UNDER_REVIEW, PAID, REJECTED
  rejectionReason  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VipRequest {
  id              String    @id @default(uuid())
  userId          String
  method          String    // "qr" | "btc"
  proofUrl        String?   // Screenshot URL for QR
  txHash          String?   // Bitcoin transaction hash
  utrNumber       String?   // UPI reference / UTR
  amount          Float     @default(99.0)
  status          String    @default("pending") // "pending" | "approved" | "rejected"
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminLog {
  id               String   @id @default(uuid())
  adminUserId      String
  adminFirebaseUid String?
  adminClerkId     String?
  action           String   // e.g. "APPROVE_PAYMENT", "REJECT_PAYMENT", "ACTIVATE_SUBSCRIPTION", "DEACTIVATE_SUBSCRIPTION", "UPDATE_QR"
  targetUserId String?
  entityType   String?  // "PAYMENT", "SUBSCRIPTION", "USER", "SETTING"
  entityId     String?
  details      String?
  metadata     String?
  createdAt    DateTime @default(now())

  admin User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model PaymentRequest {
  id              String    @id @default(uuid())
  requestId       String    @unique @default(uuid())
  userId          String
  clerkUserId     String?
  userEmail       String?
  userFullName    String?
  username        String
  plan            String    @default("monthly") // "monthly" | "yearly" | "pro"
  planId          String    @default("pro_monthly")
  region          String    @default("india") // "india" | "international"
  amount          Float     @default(29.0)
  currency        String    @default("INR") // "INR" | "USD"
  paymentId       String?   // UTR / Payment ID / Transaction ID
  screenshotUrl   String?   // Secure screenshot storage path
  screenshotKey   String?   // Private storage key
  status          String    @default("UNDER_REVIEW") // "PENDING", "UNDER_REVIEW", "APPROVED", "REJECTED"
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviewedAt      DateTime?
  reviewedBy      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([clerkUserId])
}



rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isMatchParticipant(matchData) {
      return request.auth != null && (
        matchData.user1Uid == request.auth.uid ||
        matchData.user2Uid == request.auth.uid
      );
    }

    // ── Users (profile sync) ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Profiles ──────────────────────────────────────────────────────────────
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ── Matchmaking Queue ─────────────────────────────────────────────────────
    // Each doc is keyed by firebaseUid.
    // Any authenticated user can READ the queue (to find a partner).
    // Only the owner can WRITE their own entry.
    match /matchmaking/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid);
      allow update: if isAuthenticated() && (
        // Owner updates their own entry
        isOwner(uid) ||
        // Another authenticated user can flip status to 'matched' during atomic transaction
        (request.resource.data.status == 'matched' &&
         request.resource.data.keys().hasAll(['status', 'matchId', 'partnerUid', 'updatedAt']))
      );
      allow delete: if isOwner(uid);
    }

    // ── Matches ───────────────────────────────────────────────────────────────
    // Created by a participant during a Firestore transaction.
    match /matches/{matchId} {
      allow read: if isAuthenticated() && isMatchParticipant(resource.data);
      allow create: if isAuthenticated() && isMatchParticipant(request.resource.data);
      allow update: if isAuthenticated() && isMatchParticipant(resource.data);
      allow delete: if false;

      // Messages subcollection — only participants can read/write
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isMatchParticipant(
          get(/databases/$(database)/documents/matches/$(matchId)).data
        );
        allow create: if isAuthenticated() &&
          request.resource.data.senderUid == request.auth.uid &&
          isMatchParticipant(
            get(/databases/$(database)/documents/matches/$(matchId)).data
          );
        allow update, delete: if false;
      }
    }

    // ── Legacy chatSessions (Prisma-backed, kept for compatibility) ───────────
    match /chatSessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.userAId == request.auth.uid ||
        resource.data.userBId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userAId == request.auth.uid ||
        request.resource.data.userBId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.userAId == request.auth.uid ||
        resource.data.userBId == request.auth.uid
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Default Deny ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Users & Profiles ──────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    match /profiles/{userId} {
      allow read, write: if true;
    }

    // ── Matchmaking Queue ─────────────────────────────────────────────────────
    // Real-time matchmaking queue accessible for seamless matching
    match /matchmaking/{uid} {
      allow read, write: if true;
    }

    // ── Matches & Messages ────────────────────────────────────────────────────
    // Active match rooms and 1-to-1 real-time messaging
    match /matches/{matchId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ── Legacy chatSessions (Prisma compatibility) ───────────────────────────
    match /chatSessions/{sessionId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // ── Default Allow for app documents ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
